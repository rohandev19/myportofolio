# Copy this file to .env.local and fill in the values.

# Required to access /dashboard/* (HTTP Basic Auth).
# If either is missing, the dashboard responds with 503 (fail-safe closed).
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Optional: increases GitHub API rate limits for the GitHub stats widgets.
GITHUB_TOKEN=

# Optional: enables the contact form to send emails via Web3Forms.
WEB3FORMS_ACCESS_KEY=

# Used to build absolute URLs for the RSS feed / sitemap.
NEXT_PUBLIC_SITE_URL=https://rohandev.com
